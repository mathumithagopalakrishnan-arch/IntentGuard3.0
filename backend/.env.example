# IntentGuard local configuration

# Required local API security token (replace with a random 32+ character value)
INTENTGUARD_API_TOKEN=

# PayPal Sandbox credentials (never use Live credentials here)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# PayPal return URLs
PAYPAL_RETURN_URL=http://localhost:5173/checkout/return
PAYPAL_CANCEL_URL=http://localhost:5173/checkout/cancel

# Payment settings
PAYPAL_ALLOWED_CURRENCIES=USD
CONSENT_TTL_SECONDS=900

# Optional Gemini configuration
GEMINI_API_KEY=
GEMINI_MODEL=

# Frontend security
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
